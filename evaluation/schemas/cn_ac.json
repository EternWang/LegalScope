{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["A", "C", "review_notes", "cap_rules_triggered", "audit_flags"],
  "properties": {
    "A": {"type": "integer", "minimum": 0, "maximum": 4},
    "C": {"type": "integer", "minimum": 0, "maximum": 4},
    "review_notes": {"type": "string", "minLength": 20},
    "cap_rules_triggered": {"type": "array", "items": {"type": "string"}},
    "audit_flags": {"type": "array", "items": {"type": "string"}}
  }
}
